# Configuração do Servidor
PORT=5000
NODE_ENV=development

# Configuração do Banco de Dados
DB_PATH=./data/steam_skins.db

# Steam Market API
STEAM_API_REGION=US
STEAM_CURRENCY=1

# Ciclo de Atualização (em minutos)
UPDATE_INTERVAL=120

# Parâmetros da Estratégia
MIN_CONFIDENCE=60
HOLD_DAYS=15
MAX_DAYS=30
TARGET_ROI_BUY=20
TARGET_ROI_SELL=10
