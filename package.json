{
  "name": "steam-skin-analyzer",
  "version": "1.0.0",
  "description": "Analisador de skins do mercado Steam para identificar oportunidades de compra e venda",
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "cross-env NODE_OPTIONS='--loader ts-node/esm --experimental-specifier-resolution=node --no-warnings' ts-node-esm src/index.ts",
    "server:build": "tsc",
    "server:start": "node dist/src/index.js",
    "client:dev": "cd frontend && npm start",
    "client:build": "cd frontend && npm run build",
    "collect-data": "cross-env NODE_OPTIONS='--loader ts-node/esm --experimental-specifier-resolution=node --no-warnings' ts-node-esm src/collectors/steamCollector.ts",
    "analyze": "cross-env NODE_OPTIONS='--loader ts-node/esm --experimental-specifier-resolution=node --no-warnings' ts-node-esm src/analyzers/technicalAnalyzer.ts",
    "test": "jest"
  },
  "dependencies": {
    "axios": "^1.6.5",
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "technicalindicators": "^3.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8",
    "cross-env": "^7.0.3"
  }
}
